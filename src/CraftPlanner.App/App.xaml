<Application x:Class="CraftPlanner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CraftPlanner.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <conv:Base64ToImageConverter x:Key="Base64ToImage" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverse" Inverse="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:NullToVisibilityConverter x:Key="NotNullToVis" Inverse="True" />
        <conv:MemoColorConverter x:Key="MemoColor" />
        <conv:CraftabilityBrushConverter x:Key="CraftabilityBrush" />
        <conv:ZoomPercentConverter x:Key="ZoomPercent" />

        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F4F5F7" />
        <SolidColorBrush x:Key="BorderBrushLight" Color="#D0D4DB" />
        <SolidColorBrush x:Key="NodeBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CycleBrush" Color="#FFE0E0" />
        <SolidColorBrush x:Key="WarnBrush" Color="#C0392B" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="1" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Application.Resources>
</Application>
