<Window x:Class="CraftPlanner.App.Views.RecipePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CraftPlanner.App.Views"
        Title="レシピの比較と選択" Width="560" Height="480" MinWidth="420" MinHeight="300" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="各レシピを使った場合の必要素材をプレビューしています。「採用」を押すまで計算結果は変わりません。" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="採用" IsDefault="True" Click="Ok_Click" MinWidth="90" />
            <Button Content="キャンセル" IsCancel="True" MinWidth="90" />
        </StackPanel>
        <ListBox x:Name="List" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type views:RecipeOption}">
                    <Border Padding="6,4">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding Title, Mode=OneWay}" />
                                <Run Text="{Binding CurrentMark, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                            </TextBlock>
                            <TextBlock Text="{Binding CraftsText}" Style="{StaticResource MutedText}" />
                            <ItemsControl ItemsSource="{Binding Lines}" Margin="10,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
