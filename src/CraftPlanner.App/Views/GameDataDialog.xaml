<Window x:Class="CraftPlanner.App.Views.GameDataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ゲームデータの管理" Width="520" Height="400" MinWidth="400" MinHeight="280" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="ゲームごとにアイテムとレシピを別々に管理します。制作計画はどのゲームデータを参照しているかを記録しています。" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="新規…" Click="New_Click" />
            <Button Content="名前変更…" Click="Rename_Click" />
            <Button Content="削除…" Click="Delete_Click" />
            <Button Content="選択して閉じる" IsDefault="True" Click="Select_Click" MinWidth="110" />
            <Button Content="閉じる" IsCancel="True" MinWidth="80" />
        </StackPanel>
        <ListView x:Name="List">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名前" Width="200" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="アイテム数" Width="80" DisplayMemberBinding="{Binding Items}" />
                    <GridViewColumn Header="計画数" Width="70" DisplayMemberBinding="{Binding Plans}" />
                    <GridViewColumn Header="ID" Width="130" DisplayMemberBinding="{Binding Id}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
