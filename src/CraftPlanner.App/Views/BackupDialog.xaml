<Window x:Class="CraftPlanner.App.Views.BackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CraftPlanner.App.Views"
        Title="バックアップと復元" Width="720" Height="520" MinWidth="520" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="保存のたびに直前の内容をバックアップしています。復元すると、現在の内容も先にバックアップしてから選んだ世代に置き換えます。壊れたバックアップは復元しません。" />
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Text="対象: " VerticalAlignment="Center" />
            <ComboBox x:Name="TargetBox" DisplayMemberPath="Label" SelectionChanged="TargetBox_SelectionChanged" />
        </DockPanel>
        <TextBlock x:Name="PathText" DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="0,4,0,6" TextWrapping="Wrap" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="バックアップフォルダーを開く" Click="OpenFolder_Click" />
            <Button Content="今すぐバックアップを作成" Click="CreateNow_Click" />
            <Button x:Name="RestoreButton" Content="選択した世代に復元…" Click="Restore_Click" MinWidth="140" />
            <Button Content="閉じる" IsCancel="True" MinWidth="80" />
        </StackPanel>
        <ListView x:Name="List">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="作成日時" Width="200" DisplayMemberBinding="{Binding When}" />
                    <GridViewColumn Header="サイズ" Width="100" DisplayMemberBinding="{Binding Size}" />
                    <GridViewColumn Header="ファイル" Width="360" DisplayMemberBinding="{Binding FileName}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
