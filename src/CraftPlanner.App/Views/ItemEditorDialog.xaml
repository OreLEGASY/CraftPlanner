<Window x:Class="CraftPlanner.App.Views.ItemEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CraftPlanner.App.Views"
        Title="アイテムの編集" Width="900" Height="640" MinWidth="700" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"
                       Text="名前だけ入力すれば登録できます。ほかの項目は任意です。" />
            <Button Content="OK" IsDefault="True" Click="Ok_Click" MinWidth="90" />
            <Button Content="キャンセル" IsCancel="True" MinWidth="90" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <!-- ===== 基本情報 ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="名前 *" Style="{StaticResource HeaderText}" />
                    <TextBox x:Name="NameBox" />
                    <TextBlock Text="ID" Style="{StaticResource HeaderText}" />
                    <TextBox x:Name="IdBox" ToolTip="新規作成時のみ変更できます。空欄なら自動で発行します。使える文字: 英数字 - _ ." />
                    <TextBlock Text="概要" Style="{StaticResource HeaderText}" />
                    <TextBox x:Name="SummaryBox" />
                    <TextBlock Text="詳細説明" Style="{StaticResource HeaderText}" />
                    <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                    <TextBlock Text="入手方法" Style="{StaticResource HeaderText}" />
                    <TextBox x:Name="AcquisitionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                    <TextBlock Text="アイコン" Style="{StaticResource HeaderText}" />
                    <DockPanel>
                        <Border Width="64" Height="64" Background="#E9EBEF" CornerRadius="4" DockPanel.Dock="Left" Margin="0,0,8,0">
                            <Image x:Name="IconImage" Stretch="Uniform" Margin="4" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <Button Content="画像を選択…" Click="PickIcon_Click" HorizontalAlignment="Left" />
                            <Button Content="クリア" Click="ClearIcon_Click" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource MutedText}" Text="最大 128×128 に縮小して保存します。元の画像ファイルは変更しません。" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="このアイテムを使うレシピ（自動）" Style="{StaticResource HeaderText}" />
                    <ItemsControl x:Name="UsagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== レシピ ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="このアイテムを作るレシピ" Style="{StaticResource HeaderText}" />
                <DockPanel Grid.Row="1">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="レシピを追加" Click="AddRecipe_Click" />
                        <Button Content="レシピを削除" Click="RemoveRecipe_Click" />
                    </StackPanel>
                    <ListBox x:Name="RecipeList" Height="90" SelectionChanged="RecipeList_SelectionChanged" DisplayMemberPath="Header" />
                </DockPanel>
                <Border Grid.Row="2" x:Name="RecipePanel" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" Padding="8" Margin="0,8,0,0" IsEnabled="False">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="レシピ名（任意）" Style="{StaticResource MutedText}" />
                                <TextBox x:Name="RecipeNameBox" TextChanged="RecipeField_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="完成数量" Style="{StaticResource MutedText}" />
                                <TextBox x:Name="OutputBox" TextChanged="RecipeField_Changed" />
                            </StackPanel>
                        </Grid>
                        <DockPanel DockPanel.Dock="Top" Margin="0,8,0,4">
                            <Button DockPanel.Dock="Right" Content="素材を追加…" Click="AddMaterial_Click" />
                            <TextBlock Text="必要素材（0 種類でも登録できます: 採取・購入・報酬など）" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <ListBox x:Name="MaterialList" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type views:MaterialDraft}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="削除" Style="{StaticResource SmallButton}" Click="RemoveMaterial_Click" />
                                        <TextBox DockPanel.Dock="Right" Width="56" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="6,0" />
                                        <TextBlock Text="×" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding ItemId, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
