<Window x:Class="CraftPlanner.App.Views.PlanListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CraftPlanner.App.Views"
        Title="制作計画を開く" Width="560" Height="440" MinWidth="420" MinHeight="300" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="新規…" Click="New_Click" />
            <Button Content="名前変更…" Click="Rename_Click" />
            <Button Content="削除…" Click="Delete_Click" />
            <Button Content="開く" IsDefault="True" Click="Open_Click" MinWidth="90" />
            <Button Content="閉じる" IsCancel="True" MinWidth="80" />
        </StackPanel>
        <ListView x:Name="List" MouseDoubleClick="List_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="計画名" Width="240" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="ノード数" Width="80" DisplayMemberBinding="{Binding Nodes}" />
                    <GridViewColumn Header="状態" Width="120" DisplayMemberBinding="{Binding State}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
