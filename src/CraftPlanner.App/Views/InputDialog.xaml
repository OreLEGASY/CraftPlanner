<Window x:Class="CraftPlanner.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="入力" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock x:Name="LabelText" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBox x:Name="InputBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok_Click" MinWidth="80" />
            <Button Content="キャンセル" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
