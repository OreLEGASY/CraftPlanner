<Window x:Class="CraftPlanner.App.Views.MergePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CraftPlanner.App.Views"
        Title="取り込み内容の確認" Width="980" Height="620" MinWidth="700" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" />
        <Border x:Name="ErrorBox" DockPanel.Dock="Top" Background="#FFF1F1" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,6" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="取り込みを中止しました。次の問題を修正してください。" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" />
                <ItemsControl x:Name="ErrorList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="ApplyButton" Content="適用" IsDefault="True" Click="Apply_Click" MinWidth="100" />
                <Button Content="キャンセル" IsCancel="True" MinWidth="90" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="競合をすべて更新" Click="AllUpdate_Click" />
                <Button Content="競合をすべて除外" Click="AllSkip_Click" />
                <Button Content="空 ID をすべて新 ID で取り込む" Click="AllEmptyNew_Click" />
            </StackPanel>
        </DockPanel>
        <ListView x:Name="Rows" HorizontalContentAlignment="Stretch">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="行" Width="44" DisplayMemberBinding="{Binding RowText}" />
                    <GridViewColumn Header="種類" Width="80" DisplayMemberBinding="{Binding KindText}" />
                    <GridViewColumn Header="ID" Width="130" DisplayMemberBinding="{Binding Id}" />
                    <GridViewColumn Header="名前" Width="140" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="変更内容（変更前 → 変更後）" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type views:MergeRow}">
                                <TextBlock Text="{Binding ChangesText}" TextWrapping="Wrap" MaxWidth="290" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="処理" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type views:MergeRow}">
                                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="Label"
                                          IsEnabled="{Binding CanChoose}" MinWidth="130" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="レシピも反映" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type views:MergeRow}">
                                <CheckBox IsChecked="{Binding IncludeRecipes}" IsEnabled="{Binding CanIncludeRecipes}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
