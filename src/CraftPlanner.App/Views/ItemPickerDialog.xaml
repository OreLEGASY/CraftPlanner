<Window x:Class="CraftPlanner.App.Views.ItemPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CraftPlanner.App.ViewModels"
        Title="アイテムを選択" Width="520" Height="560" MinWidth="400" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                 ToolTip="名前・概要・詳細説明・入手方法で検索" />
        <Border x:Name="ModePanel" DockPanel.Dock="Top" Visibility="Collapsed" Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="追加のしかた" FontWeight="SemiBold" Margin="0,0,0,4" />
                <RadioButton x:Name="ExpandRadio" IsChecked="True" Content="制作目標として追加（素材ツリーを自動で展開する）" />
                <RadioButton x:Name="SingleRadio" Content="ノードだけ追加（展開しない。あとから「展開」できる）" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="新規作成…" Click="CreateNew_Click" MinWidth="100" ToolTip="未登録のアイテムをその場で作成します" />
            <Button Content="選択" IsDefault="True" Click="Ok_Click" MinWidth="80" />
            <Button Content="キャンセル" IsCancel="True" MinWidth="80" />
        </StackPanel>
        <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        <ListBox x:Name="List" Margin="0,8,0,0" HorizontalContentAlignment="Stretch" MouseDoubleClick="List_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ItemCardViewModel}">
                    <DockPanel Margin="2">
                        <Border DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,8,0" Background="#E9EBEF" CornerRadius="4">
                            <Image Source="{Binding Icon}" Stretch="Uniform" Margin="2" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Id, Mode=OneWay}" /> <Run Text="{Binding Summary, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
